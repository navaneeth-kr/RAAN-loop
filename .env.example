# Brightloop Software - Environment Configuration Example

SECRET_KEY=django-insecure-brightloop-saas-production-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SMTP Email Configuration (Section 16)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Brightloop Software <billing@brightloop.io>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@brightloop.io
EMAIL_HOST_PASSWORD=your-app-password
