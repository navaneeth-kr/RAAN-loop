# App settings
INVOICE_DUE_DAYS=30
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=123 Main St, City, Country
COMPANY_PHONE=+1 234 567 8900
COMPANY_EMAIL=billing@yourcompany.com

